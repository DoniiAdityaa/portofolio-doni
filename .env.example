# Copy to .env.local and fill in. Never commit .env.local.
# Each variable becomes required in the milestone noted above it
# (see docs/CASE_02_TECHNICAL_PLANNING.md §12).

# ---- Public: inlined into the browser bundle ----

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# M3: local values are printed by `pnpm db:start` (API URL and publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only: never prefix with NEXT_PUBLIC_ ----

# M6: only the daily GitHub cron job uses it (it bypasses RLS). Local value: `supabase status`.
SUPABASE_SECRET_KEY=
# Dashboard: fine-grained, read-only, public data. Without it the Dashboard shows dummy data.
GITHUB_TOKEN=
# M6: protects /api/cron/github; Vercel Cron sends it as a Bearer token. Any long random string.
CRON_SECRET=
# M6: secret for the daily visitor hash and the contact rate limit. Any long random string.
VISITOR_HASH_SALT=
