# Copy to .env.local and fill in. Never commit .env.local.
# Each variable becomes required in the milestone noted above it
# (see docs/CASE_02_TECHNICAL_PLANNING.md §12).

# ---- Public: inlined into the browser bundle ----

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# M3
NEXT_PUBLIC_SUPABASE_URL=
# M3
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only: never prefix with NEXT_PUBLIC_ ----

# M6
SUPABASE_SECRET_KEY=
# Dashboard: fine-grained, read-only, public data. Without it the Dashboard shows dummy data.
GITHUB_TOKEN=
# M6
CRON_SECRET=
# M6
VISITOR_HASH_SALT=
